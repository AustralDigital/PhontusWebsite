# Public canonical origin used for metadata, robots, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://phontus.live

# Optional email delivery adapter. The contact form remains honest and shows an
# email fallback until both values are configured.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@phontus.live
CONTACT_FROM_EMAIL=Phontus Website <website@phontus.live>
